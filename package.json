{
    "name": "frisqueendom",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run build:wasm && vite build",
        "build:wasm": "cd frisque-physics && wasm-pack build --target web --release",
        "build:wasm:dev": "cd frisque-physics && wasm-pack build --target web --dev",
        "lan:relay": "node server/lan-relay.cjs",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "npm run typecheck && npm run test:rust && npm run test:unit",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:e2e": "playwright test",
        "test:rust": "cd frisque-physics && cargo test",
        "test:rust:verbose": "cd frisque-physics && cargo test -- --nocapture",
        "test:all": "npm run test:rust && npm run test:unit && npm run test:e2e"
    },
    "dependencies": {
        "three": "^0.170.0",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "@types/three": "^0.170.0",
        "happy-dom": "^20.5.0",
        "typescript": "^5.7.0",
        "vite": "^6.4.0",
        "vitest": "^4.0.18"
    }
}
